---
import { Image } from "astro:assets";
import { getImage } from "../utils/images";
interface Props {
  variant: string;
}
const { variant } = Astro.props;
---

<div class={`myContainer ${variant}`}>
  <a href="/" transition:name="avatar">
    <Image width={208} height={208} class="avatar" src={getImage("site/avatar.jpg")} alt="" />
  </a>
</div>

<style>
  .myContainer {
    width: 5rem;
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transform-origin: center;
    position: relative;
  }
  .avatar {
    border-radius: 50%;
    width: 3rem;
    height: 3rem;
    box-shadow: 0 0 0 2px rgba(0, 255, 255, 0.5);
  }

  /* En home, el avatar "vive" en su posición final (chica, esquina) desde
     el vacío del layout, y una animación de transform lo hace entrar desde
     el centro para no provocar reflow del resto del contenido. */
  .home {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 20;
  }
  @media (prefers-reduced-motion: no-preference) {
    .home {
      animation: settle 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
  }
  @keyframes settle {
    0% {
      transform: translate(38vw, 42vh) scale(4);
    }
    65% {
      transform: translate(38vw, 42vh) scale(4);
    }
    100% {
      transform: translate(0, 0) scale(1);
    }
  }
</style>
