---
import { Image } from "astro:assets";
import { getImage } from "../utils/images";
interface Props {
  variant: string;
  href?: string;
}
const { variant, href = "/" } = Astro.props;
---

<div class={`myContainer ${variant}`}>
  <a href={href} transition:name="avatar">
    <Image width={208} height={208} class="avatar" src={getImage("site/avatar.jpg")} alt="" />
  </a>
</div>

<style>
  .myContainer {
    width: 5rem;
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transform-origin: center;
    position: relative;
  }
  .avatar {
    border-radius: 50%;
    width: 3rem;
    height: 3rem;
    box-shadow: 0 0 0 2px rgba(0, 255, 255, 0.5);
  }

  /* En home, el avatar es una celda más del bento grid (no flota fijo).
     La animación es solo un transform que lo hace "volar" desde el centro
     de la pantalla hasta su posición natural dentro de la grilla, sin
     afectar el flujo del resto del contenido. */
  .home {
    width: 6.5rem;
    height: 6.5rem;
  }
  .home .avatar {
    width: 6.5rem;
    height: 6.5rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .home {
      animation: settle 2.4s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }
  @keyframes settle {
    0% {
      transform: translate(32vw, 38vh) scale(2.2);
    }
    45% {
      transform: translate(32vw, 38vh) scale(2.2);
    }
    100% {
      transform: translate(0, 0) scale(1);
    }
  }
</style>
