---
import { Image } from "astro:assets";
import { getImage } from "../utils/images";
interface Props {
  variant: string;
  href?: string;
}
const { variant, href = "/" } = Astro.props;
---

<div class={`myContainer ${variant}`}>
  <a href={href} transition:name="avatar">
    <Image width={208} height={208} class="avatar" src={getImage("site/avatar.jpg")} alt="" />
  </a>
</div>

<style>
  .myContainer {
    width: 5rem;
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transform-origin: center;
    position: relative;
  }
  .avatar {
    border-radius: 50%;
    width: 3rem;
    height: 3rem;
    box-shadow: 0 0 0 2px rgba(0, 255, 255, 0.5);
  }

  /* Variante "photo": tile vertical de foto completa para el bento grid del
     home. Es su propia celda de grilla, no un círculo chico. */
  .photo {
    width: 100%;
    height: 100%;
    min-height: 220px;
  }
  .photo a {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 1rem;
    overflow: hidden;
  }
  .photo .avatar {
    width: 100%;
    height: 100%;
    border-radius: 1rem;
    object-fit: cover;
    object-position: center 25%;
    box-shadow: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .photo {
      animation: settle 2.4s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }
  @keyframes settle {
    0% {
      transform: translate(32vw, 38vh) scale(1.6);
    }
    45% {
      transform: translate(32vw, 38vh) scale(1.6);
    }
    100% {
      transform: translate(0, 0) scale(1);
    }
  }
</style>
