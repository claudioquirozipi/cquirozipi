---
import { Image } from "astro:assets";
import { getImage } from "../utils/images";
interface Props {
  variant: string;
  href?: string;
}
const { variant, href = "/" } = Astro.props;
---

<div class={`myContainer ${variant}`}>
  <a href={href} transition:name="avatar">
    <Image width={208} height={208} class="avatar" src={getImage("site/avatar.jpg")} alt="" />
  </a>
</div>

<style>
  .myContainer {
    width: 5rem;
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transform-origin: center;
    position: relative;
  }
  .avatar {
    border-radius: 50%;
    width: 3rem;
    height: 3rem;
    box-shadow: 0 0 0 2px var(--color-primary, #d66879);
  }

  /* Variante "header": foto cuadrada con esquinas redondeadas para la
     cabecera de las páginas internas (LayoutGrid), más grande que el
     círculo pequeño pero sin ocupar una celda completa del bento. */
  .header {
    width: 4.5rem;
    height: 4.5rem;
  }
  .header a {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.1));
    box-shadow: var(--glass-shadow, 0 8px 32px 0 rgba(0, 0, 0, 0.37));
  }
  .header .avatar {
    width: 100%;
    height: 100%;
    border-radius: 0;
    object-fit: cover;
    object-position: center 25%;
    box-shadow: none;
  }

  /* Variante "photo": tile vertical de foto completa para el bento grid del
     home. Es su propia celda de grilla, no un círculo chico. */
  .photo {
    width: 100%;
    height: 100%;
    min-height: 220px;
  }
  .photo a {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.1));
    box-shadow: var(--glass-shadow, 0 8px 32px 0 rgba(0, 0, 0, 0.37));
  }
  .photo .avatar {
    width: 100%;
    height: 100%;
    border-radius: 0;
    object-fit: cover;
    object-position: center 25%;
    box-shadow: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .photo {
      animation: settle 2.4s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }
  @keyframes settle {
    0% {
      transform: translate(32vw, 38vh) scale(1.6);
    }
    45% {
      transform: translate(32vw, 38vh) scale(1.6);
    }
    100% {
      transform: translate(0, 0) scale(1);
    }
  }
</style>
