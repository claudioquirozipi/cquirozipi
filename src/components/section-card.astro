---
interface Props {
  href: string;
  title: string;
  description: string;
  index?: number;
  area: string;
}
const { href, title, description, index = 0, area } = Astro.props;
---

<a
  href={href}
  class="card"
  style={`grid-area: ${area}; --delay: ${index * 0.12}s`}
>
  <div class="icon"><slot /></div>
  <h2 class="title">{title}</h2>
  <p class="description">{description}</p>
  <span class="cta">Ver más →</span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border-radius: 1rem;
    border: 1px solid rgba(0, 255, 255, 0.25);
    background: rgba(0, 107, 222, 0.08);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease-in-out, background 0.2s ease-in-out;
  }
  .card:hover {
    border-color: #00ffff;
    background: rgba(0, 107, 222, 0.16);
  }
  @media (prefers-reduced-motion: no-preference) {
    .card {
      opacity: 0;
      transform: translateY(12px);
      animation: rise 0.5s ease-out forwards;
      animation-delay: calc(1.8s + var(--delay));
    }
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .icon {
    width: 2rem;
    height: 2rem;
  }
  .title {
    margin: 0;
    color: #00ffff;
    font-size: 1.1rem;
    font-weight: bold;
    text-shadow: 1px 1px 5px #006bde;
  }
  .description {
    margin: 0;
    color: #00ffff;
    font-size: 0.85rem;
    opacity: 0.85;
  }
  .cta {
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: 0.75rem;
    color: #00ffff;
  }
</style>
