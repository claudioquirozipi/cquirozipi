---
import type { Experience } from "../data/experience";
import { Image } from "astro:assets";
import { formatDate } from "../utils/functions/formatDate";
import { getImage } from "../utils/images";

interface Props {
  experience: Experience;
  showLineAfter: boolean;
  showLineBefore: boolean;
}

const { experience, showLineAfter, showLineBefore } = Astro.props;
---

<div class="main">
  <div class="imageContainer">
    <div class="subImageContainer">
      {showLineAfter && <span class="line line-after" />}
      {showLineBefore && <span class="line line-before" />}
      {
        experience.logo ? (
          <Image
            width={100}
            height={100}
            class="image"
            src={getImage(experience.logo)}
            alt=""
          />
        ) : (
          <Image
            width={100}
            height={100}
            class="image imageDefault"
            src={getImage("experience/freelance.png")}
            alt=""
          />
        )
      }
    </div>
  </div>
  <h3 class="date">
    {
      `del ${formatDate(experience.startDate)} al ${formatDate(
        experience.endDate
      )}`
    }
  </h3>
  <h2 class="title">{experience.title}</h2>
  <p class="description">{experience.description}</p>
</div>

<style>
  .main {
    padding: var(--space-2, 1rem) var(--space-3, 1.5rem);
    border-radius: 16px;
    border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.1));
    background: var(--glass-bg, rgba(45, 22, 53, 0.4));
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 var(--space-2, 1rem);
    margin-bottom: var(--space-2, 1rem);
  }
  .imageContainer {
    width: 3rem;
    height: 100%;
    grid-column: 1/2;
    grid-row: 1/3;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }
  .subImageContainer {
    width: 3rem;
    height: 3rem;
    grid-column: 1/2;
    grid-row: 1/3;
    background-color: var(--color-primary, #d66879);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }
  .line {
    position: absolute;
    width: 1px;
    height: 70%;
    background-color: var(--color-secondary, #f39c12);
    z-index: -1;
  }
  .line-after {
    bottom: 100%;
    left: 50%;
  }
  .line-before {
    top: 100%;
    left: 50%;
  }
  .image {
    object-fit: contain;
    object-position: top center;
    border-radius: 50%;
  }

  .imageDefault {
    width: 2rem;
    height: 2rem;
  }
  .date {
    font-size: 0.7rem;
    margin: 0;
    grid-column: 2/3;
    color: var(--color-text-muted, #d2b4de);
    font-weight: 400;
  }
  .title {
    font-size: 1rem;
    margin: 0;
    grid-column: 2/3;
    color: var(--color-text-main, #f8f9fa);
  }
  .description {
    font-size: 0.85rem;
    margin: 0;
    grid-column: 2/3;
    color: var(--color-text-muted, #d2b4de);
    font-weight: 300;
  }
</style>
