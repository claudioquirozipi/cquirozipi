---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<main class="main">
  <div class="top">
    <slot name="top-left" />
    <slot name="top-left-2" />
    <slot name="top-right" />
  </div>
  <div class="titleContainer">
    <h1 class="title">{title}</h1>
  </div>
  <div class="center">
    <slot />
  </div>
  <div class="bottom">
    <slot name="bottom-left" />
    <slot name="bottom-right" />
  </div>
</main>

<style>
  .main {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    grid-gap: var(--space-3, 1.5rem);
    height: 100%;
    padding: 0 var(--space-2, 1rem) var(--space-3, 1.5rem);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-2, 1rem);
    width: 100%;
  }
  .titleContainer {
    width: fit-content;
  }
  .title {
    margin: 0;
    color: var(--color-text-main, #f8f9fa);
    font-size: 1.5rem;
    font-weight: 600;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
  }
  .center {
    overflow-y: auto;
  }
  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-2, 1rem);
    width: 100%;
  }
</style>
