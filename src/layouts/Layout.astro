---
interface Props {
  title: string;
}
import { Image } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { getImage } from "../utils/images";
import { experiences } from "../data/experience";
import { getDateDifference } from "../utils/functions/getDateDifference";
import "../styles/global.css";
const { title } = Astro.props;
const { years } = getDateDifference(
  experiences[experiences.length - 1].startDate
);
const description = `Claudio Quiroz — Ingeniero de software fullstack con ${years}+ años de experiencia en React, Node.js y TypeScript. Perú, disponible remoto.`;
const ogImage = new URL("/og-image.png", Astro.site);
const pageUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/rocks.png" />
    <link rel="shortcut icon" type="image/png" href="/rocks.png" />
    <link rel="apple-touch-icon" href="/rocks.png" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={pageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="pageBackground">
      <Image
        src={getImage("site/background.png")}
        alt=""
        width={1920}
        height={1080}
        class="bgImage"
      />
      <div class="bgScrim"></div>
    </div>
    <div class="wrapper">
      <slot />
      <footer class="contactBar" aria-label="Contacto">
        <a
          href="https://github.com/claudioquirozipi"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="22"
            height="22"
            focusable="false"
          >
            <path
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.026 2.747-1.026.546 1.378.202 2.397.1 2.65.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.749 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"
            ></path>
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/claudio-quiroz-214630bb/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="22"
            height="22"
            focusable="false"
          >
            <path
              d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"
            ></path>
          </svg>
        </a>
      </footer>
      <style>
        body {
          background: var(--color-bg-dark, #1f1424);
          padding: 1rem;
          height: 100vh;
          width: 100%;
        }
        .pageBackground {
          position: fixed;
          inset: 0;
          z-index: -1;
          overflow: hidden;
        }
        .bgImage {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
        .bgScrim {
          position: absolute;
          inset: 0;
          background: linear-gradient(
            180deg,
            rgba(31, 20, 36, 0.25) 0%,
            rgba(31, 20, 36, 0.35) 100%
          );
        }
        .wrapper {
          padding: 0.5rem;
          height: 100%;
        }
        .contactBar {
          position: fixed;
          bottom: 0.75rem;
          left: 50%;
          transform: translateX(-50%);
          display: flex;
          align-items: center;
          gap: 1.25rem;
          padding: 0.6rem 1.25rem;
          border-radius: 999px;
          border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.1));
          background: var(--glass-bg, rgba(45, 22, 53, 0.4));
          backdrop-filter: var(--glass-blur, blur(16px) saturate(120%));
          -webkit-backdrop-filter: var(
            --glass-blur,
            blur(16px) saturate(120%)
          );
          box-shadow: var(--glass-shadow, 0 8px 32px 0 rgba(0, 0, 0, 0.37));
          z-index: 10;
        }
        .contactBar a {
          display: flex;
        }
        .contactBar svg path {
          fill: var(--color-text-muted, #d2b4de);
          transition: fill 0.2s ease-in-out;
        }
        .contactBar a:hover svg path {
          fill: var(--color-secondary, #f39c12);
        }
      </style>
    </div>
  </body><!-- 00FFFF --><!-- 006BDE --><!-- 00020A  rgba(0, 107, 222, 0.3);-->
</html>
