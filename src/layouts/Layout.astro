---
interface Props {
  title: string;
}
import { Image } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { getImage } from "../utils/images";
import "../styles/global.css";
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Claudio Quiroz | fullstack developer" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/logo.jpg" />
    <link rel="shortcut icon" href="/logo.jpg" />
    <meta property="og:image" content="avatar.jpg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="wrapper">
      <slot />
      <nav class="contactBar" aria-label="Contacto">
        <a
          href="https://github.com/claudioquirozipi"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
        >
          <Image
            class="contactIcon"
            width="30"
            height="30"
            src={getImage("site/github.png")}
            alt=""
          />
        </a>
        <a
          href="https://www.linkedin.com/in/claudio-quiroz-214630bb/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="#00ffff"
            width="24"
            height="24"
            focusable="false"
          >
            <path
              d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"
            ></path>
          </svg>
        </a>
      </nav>
      <style>
        body {
          background: rgb(0, 107, 222);
          background: radial-gradient(
            circle,
            rgba(0, 107, 222, 1) 0%,
            rgba(0, 2, 10, 1) 51%,
            rgba(0, 2, 10, 1) 100%
          );
          padding: 1rem;
          height: 100vh;
          width: 100%;
        }
        .wrapper {
          padding: 0.5rem;
          height: 100%;
        }
        .contactBar {
          position: fixed;
          top: 1rem;
          right: 1rem;
          display: flex;
          align-items: center;
          gap: 1rem;
          z-index: 10;
        }
        .contactIcon {
          filter: invert(80%) sepia(50%) saturate(996%) hue-rotate(119deg)
            brightness(104%) contrast(104%);
        }
      </style>
    </div>
  </body><!-- 00FFFF --><!-- 006BDE --><!-- 00020A  rgba(0, 107, 222, 0.3);-->
</html>
