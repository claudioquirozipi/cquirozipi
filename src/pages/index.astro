---
import Layout from "../layouts/Layout.astro";
import Avatar from "../components/avatar.astro";
import SectionCard from "../components/section-card.astro";
import AboutIcon from "../icons/about-icon.astro";
import ExperienceIcon from "../icons/experience-icon.astro";
import ProjectIcon from "../icons/project-icon.astro";
import CertificatesIcon from "../icons/certificates-icon.astro";
import RecommendationsIcon from "../icons/recommendations-icon.astro";
import { experiences } from "../data/experience";
import { getDateDifference } from "../utils/functions/getDateDifference";

const { years } = getDateDifference(
  experiences[experiences.length - 1].startDate
);
---

<Layout title="Claudio Quiroz | Fullstack Developer">
  <main>
    <div class="bento">
      <div class="photoTile">
        <Avatar variant="photo" href="/sobre-mi" />
      </div>
      <SectionCard
        area="about"
        href="/sobre-mi"
        title="Ing. Claudio Quiroz"
        description="Fullstack Developer | React Node — quién soy y cómo trabajo."
        index={0}
      >
        <AboutIcon />
      </SectionCard>
      <SectionCard
        area="experience"
        href="/experiencia"
        title="Experiencia"
        description={`${years}+ años construyendo software.`}
        index={1}
      >
        <ExperienceIcon />
      </SectionCard>
      <SectionCard
        area="certificates"
        href="/certificados"
        title="Certificados"
        description="Formación y cursos."
        index={2}
      >
        <CertificatesIcon />
      </SectionCard>
      <SectionCard
        area="projects"
        href="/proyectos"
        title="Proyectos"
        description="Cosas que construí."
        index={3}
      >
        <ProjectIcon />
      </SectionCard>
      <SectionCard
        area="recommendations"
        href="/recomendaciones"
        title="Recomendaciones"
        description="Lo que dicen de trabajar conmigo."
        index={4}
      >
        <RecommendationsIcon />
      </SectionCard>
    </div>
  </main>
</Layout>

<style>
  main {
    display: flex;
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding-top: 3rem;
    padding-bottom: 4rem;
  }
  .bento {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, minmax(140px, auto));
    grid-template-areas:
      "photo about about"
      "photo experience certificates"
      "projects recommendations recommendations";
    gap: 1rem;
  }
  @media (max-width: 640px) {
    .bento {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-template-areas:
        "photo"
        "about"
        "experience"
        "projects"
        "certificates"
        "recommendations";
    }
  }
  .photoTile {
    grid-area: photo;
  }
</style>
