---
import Layout from "../layouts/Layout.astro";
import Avatar from "../components/avatar.astro";
import SectionCard from "../components/section-card.astro";
import AboutIcon from "../icons/about-icon.astro";
import ExperienceIcon from "../icons/experience-icon.astro";
import ProjectIcon from "../icons/project-icon.astro";
import CertificatesIcon from "../icons/certificates-icon.astro";
import RecommendationsIcon from "../icons/recommendations-icon.astro";
import { experiences } from "../data/experience";
import { getDateDifference } from "../utils/functions/getDateDifference";

const { years } = getDateDifference(
  experiences[experiences.length - 1].startDate
);
---

<Layout title="Claudio Quiroz | Fullstack Developer">
  <main>
    <Avatar variant="home" />
    <div class="header">
      <p class="name">Ing. Claudio Quiroz</p>
      <p class="role">Fullstack Developer | React Node</p>
    </div>
    <div class="bento">
      <SectionCard
        href="/sobre-mi"
        title="Sobre mí"
        description="Quién soy y cómo trabajo."
        index={0}
        large
      >
        <AboutIcon />
      </SectionCard>
      <SectionCard
        href="/experiencia"
        title="Experiencia"
        description={`${years}+ años construyendo software.`}
        index={1}
      >
        <ExperienceIcon />
      </SectionCard>
      <SectionCard
        href="/proyectos"
        title="Proyectos"
        description="Cosas que construí."
        index={2}
      >
        <ProjectIcon />
      </SectionCard>
      <SectionCard
        href="/certificados"
        title="Certificados"
        description="Formación y cursos."
        index={3}
      >
        <CertificatesIcon />
      </SectionCard>
      <SectionCard
        href="/recomendaciones"
        title="Recomendaciones"
        description="Lo que dicen de trabajar conmigo."
        index={4}
      >
        <RecommendationsIcon />
      </SectionCard>
    </div>
  </main>
</Layout>

<style>
  main {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding-top: 5rem;
  }
  .header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .name {
    margin: 0;
    font-size: 1.3rem;
    font-weight: bold;
    color: #00ffff;
    text-shadow: 1px 1px 5px #006bde;
  }
  .role {
    margin: 0.25rem 0 0;
    color: #006bde;
    font-size: 1rem;
  }
  .bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: minmax(140px, auto);
    grid-auto-flow: dense;
    gap: 1rem;
  }
  @media (max-width: 640px) {
    .bento {
      grid-template-columns: 1fr;
    }
  }
</style>
