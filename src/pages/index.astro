---
import Layout from "../layouts/Layout.astro";
import Avatar from "../components/avatar.astro";
import SectionCard from "../components/section-card.astro";
import AboutIcon from "../icons/about-icon.astro";
import ExperienceIcon from "../icons/experience-icon.astro";
import ProjectIcon from "../icons/project-icon.astro";
import CertificatesIcon from "../icons/certificates-icon.astro";
import RecommendationsIcon from "../icons/recommendations-icon.astro";
import { experiences } from "../data/experience";
import { getDateDifference } from "../utils/functions/getDateDifference";

const { years } = getDateDifference(
  experiences[experiences.length - 1].startDate
);
---

<Layout title="Claudio Quiroz | Fullstack Developer">
  <main>
    <div class="bento">
      <div class="photoTile">
        <Avatar variant="photo" href="/sobre-mi" />
      </div>
      <SectionCard
        area="about"
        href="/sobre-mi"
        title="Ing. Claudio Quiroz"
        description="Fullstack Developer | React Node — quién soy y cómo trabajo."
        index={0}
      >
        <AboutIcon />
      </SectionCard>
      <SectionCard
        area="experience"
        href="/experiencia"
        title="Experiencia"
        description={`${years}+ años construyendo software.`}
        index={1}
      >
        <ExperienceIcon />
      </SectionCard>
      <SectionCard
        area="certificates"
        href="/certificados"
        title="Certificados"
        description="Formación y cursos."
        index={2}
      >
        <CertificatesIcon />
      </SectionCard>
      <SectionCard
        area="projects"
        href="/proyectos"
        title="Proyectos"
        description="Cosas que construí."
        index={3}
      >
        <ProjectIcon />
      </SectionCard>
      <SectionCard
        area="recommendations"
        href="/recomendaciones"
        title="Recomendaciones"
        description="Lo que dicen de trabajar conmigo."
        index={4}
      >
        <RecommendationsIcon />
      </SectionCard>
    </div>
  </main>
</Layout>

<style>
  main {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 960px;
    height: 100%;
    margin: 0 auto;
    padding-top: 3rem;
    padding-bottom: 4rem;
    box-sizing: border-box;
  }
  .bento {
    display: grid;
    flex: 1;
    width: 100%;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(7,1fr);
    grid-template-areas:
      "photo photo about about experience experience"
      "photo photo about about experience experience"
      "certificates certificates certificates certificates experience experience"
      "certificates certificates certificates certificates experience experience"
      "recommendations recommendations projects projects projects projects"
      "recommendations recommendations projects projects projects projects"
      "recommendations recommendations projects projects projects projects";

    gap: 1.5rem;
  }
  @media (max-width: 640px) {
    main {
      height: 100%;
    }
    .bento {
      grid-template-columns: repeat(5, 1fr);
      grid-template-rows: repeat(7,1fr);
      grid-template-areas:
        "photo photo about about about"
        "photo photo about about about"
        "certificates certificates certificates experience experience"
        "certificates certificates certificates experience experience"
        "recommendations recommendations projects projects projects"
        "recommendations recommendations projects projects projects"
        "recommendations recommendations projects projects projects";
    }
  }
  .photoTile {
    grid-area: photo;
  }
</style>
