---
import Layout from "../layouts/Layout.astro";
import { technologies } from "../data/technologies";
import Avatar from "../components/avatar.astro";
import LayoutGrid from "../layouts/layout-grid.astro";
import TechnologiesCard from "../components/technologies-card.astro";
---

<Layout title="Tecnologías | Claudio Quiroz">
  <LayoutGrid title="Tecnologías">
    <Avatar slot="avatar" variant="header" />
    <main class="main">
      {
        technologies.map((technology) => (
          <TechnologiesCard technology={technology} />
        ))
      }
    </main>
  </LayoutGrid>
</Layout>
<style>
  .main {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    grid-gap: 2rem 1rem;
  }
</style>
