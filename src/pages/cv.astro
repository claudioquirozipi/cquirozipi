---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getImage } from "../utils/images";
import { profile } from "../data/profile";
import { experiences } from "../data/experience";
import { technologies } from "../data/technologies";
import { certificates } from "../data/certificates";
import { formatDate } from "../utils/functions/formatDate";

function formatShort(date: Date) {
  return date.toLocaleDateString("es-PE", { month: "short", year: "numeric" });
}

const categoryLabels: Record<string, string> = {
  frontend: "Frontend",
  backend: "Backend",
  lenguajes: "Lenguajes",
  basededatos: "Bases de datos",
  cloud: "Cloud",
  herramientas: "Herramientas",
};
const categoryOrder = Object.keys(categoryLabels);
const techByCategory = categoryOrder
  .map((cat) => ({
    label: categoryLabels[cat],
    items: technologies.filter((t) => t.category?.includes(cat)),
  }))
  .filter((group) => group.items.length > 0);

const coreCertificates = certificates.filter((c) => c.isCore);
---

<Layout title={`CV — ${profile.name}`}>
  <main class="cv">
    <button type="button" class="printButton" onclick="window.print()">
      Descargar CV (PDF)
    </button>

    <header class="header">
      <Image
        width={90}
        height={90}
        class="photo"
        src={getImage("site/avatar.jpg")}
        alt={profile.name}
        loading="eager"
      />
      <div class="headerText">
        <div class="nameRow">
          <img width="22" height="22" class="logo" src="/rocks.png" alt="" />
          <h1 class="name">{profile.name}</h1>
        </div>
        <p class="title">{profile.title}</p>
        <p class="contact">
          {profile.email} · {profile.location} ·{" "}
          <a href={profile.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          {" "}·{" "}
          <a href={profile.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
        </p>
      </div>
    </header>

    <section class="section">
      <p class="summary">{profile.summary}</p>
    </section>

    <section class="section">
      <h2 class="sectionTitle">Experiencia</h2>
      {
        experiences.map((company) => {
          const roleTitles = company.roles
            .slice()
            .reverse()
            .map((r) => r.title)
            .join(" → ");
          const clients = Array.from(
            new Set(
              company.roles.flatMap((r) => r.clients.map((c) => c.name))
            )
          ).join(", ");
          return (
            <div class="entry">
              <div class="entryHeader">
                <h3 class="entryTitle">{company.name}</h3>
                <span class="entryDate">
                  {formatShort(company.startDate)} – {formatShort(company.endDate)}
                </span>
              </div>
              <p class="entryRole">{roleTitles}</p>
              <p class="entryDetail">{clients}</p>
            </div>
          );
        })
      }
    </section>

    <section class="section">
      <h2 class="sectionTitle">Tecnologías</h2>
      {
        techByCategory.map((group) => (
          <p class="techLine">
            <strong>{group.label}:</strong> {group.items.map((t) => t.title).join(", ")}
          </p>
        ))
      }
    </section>

    <section class="section">
      <h2 class="sectionTitle">Certificados destacados</h2>
      {
        coreCertificates.map((c) => (
          <p class="certLine">
            {c.title} — {c.institute} ({formatDate(c.date).slice(-4)})
          </p>
        ))
      }
    </section>

    <footer class="footer">
      Portafolio completo, proyectos y recomendaciones en{" "}
      <a href="https://cquirozipi.vercel.app">cquirozipi.vercel.app</a>
    </footer>
  </main>
</Layout>

<style>
  .cv {
    max-width: 720px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
    background: #ffffff;
    color: #1f1424;
    border-radius: 16px;
    font-family: var(--font-body, sans-serif);
  }
  .printButton {
    display: block;
    margin: 0 auto 2rem;
    padding: 0.6rem 1.4rem;
    border: none;
    border-radius: 999px;
    background: var(--color-primary, #d66879);
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }
  .printButton:hover {
    background: #b8536a;
  }
  .header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--color-primary, #d66879);
  }
  .photo {
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 16px;
    object-fit: cover;
  }
  .nameRow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .logo {
    width: 1.25rem;
    height: 1.25rem;
  }
  .name {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 700;
    color: #1f1424;
  }
  .title {
    margin: 0.15rem 0 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary, #d66879);
  }
  .contact {
    margin: 0.35rem 0 0;
    font-size: 0.8rem;
    color: #5b5563;
  }
  .contact a {
    color: var(--color-primary, #d66879);
    text-decoration: none;
  }
  .section {
    margin-top: 1.5rem;
  }
  .summary {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: #1f1424;
  }
  .sectionTitle {
    margin: 0 0 0.6rem;
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary, #d66879);
    border-bottom: 1px solid #eee;
    padding-bottom: 0.3rem;
  }
  .entry {
    margin-bottom: 0.9rem;
  }
  .entryHeader {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .entryTitle {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: #1f1424;
  }
  .entryDate {
    font-size: 0.75rem;
    color: #5b5563;
    white-space: nowrap;
  }
  .entryRole {
    margin: 0.2rem 0 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-secondary, #f39c12);
  }
  .entryDetail {
    margin: 0.15rem 0 0;
    font-size: 0.8rem;
    color: #5b5563;
  }
  .techLine,
  .certLine {
    margin: 0.25rem 0;
    font-size: 0.85rem;
    color: #1f1424;
  }
  .techLine strong {
    color: #1f1424;
  }
  .footer {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid #eee;
    font-size: 0.75rem;
    color: #5b5563;
    text-align: center;
  }
  .footer a {
    color: var(--color-primary, #d66879);
    text-decoration: none;
  }

  @media print {
    .printButton {
      display: none;
    }
    .cv {
      max-width: 100%;
      padding: 0;
      border-radius: 0;
    }
    @page {
      size: A4;
      margin: 1.5cm;
    }
  }
</style>
