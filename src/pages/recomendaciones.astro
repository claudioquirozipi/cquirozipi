---
import Layout from "../layouts/Layout.astro";
import { recommendations } from "../data/recommendations";
import Certificates from "../components/certificates.astro";
import Experience from "../components/experience.astro";
import Projects from "../components/projects.astro";
import Technologies from "../components/technologies.astro";
import Avatar from "../components/avatar.astro";
import LayoutGrid from "../layouts/layout-grid.astro";
---

<Layout title="Recomendaciones | Claudio Quiroz">
  <LayoutGrid title="Recomendaciones">
    <Avatar slot="top-left" variant="2" />
    <Technologies slot="top-left-2" />
    <Certificates slot="top-right" />
    <Experience slot="bottom-right" />
    <Projects slot="bottom-left" />
    <main class="main">
      {
        recommendations.map((r) => (
          <article class="recommendation">
            <p class="quote">“{r.quote}”</p>
            <p class="author">
              {r.name} — {r.role}
              {r.company && `, ${r.company}`}
            </p>
          </article>
        ))
      }
    </main>
  </LayoutGrid>
</Layout>
<style>
  .main {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    padding: 1rem;
  }
  .recommendation {
    padding: var(--space-4, 2rem);
    border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.1));
    border-radius: 24px;
    background: var(--glass-bg, rgba(45, 22, 53, 0.4));
    backdrop-filter: var(--glass-blur, blur(16px) saturate(120%));
    -webkit-backdrop-filter: var(--glass-blur, blur(16px) saturate(120%));
    box-shadow: var(--glass-shadow, 0 8px 32px 0 rgba(0, 0, 0, 0.37));
  }
  .quote {
    margin: 0;
    color: var(--color-text-main, #f8f9fa);
    font-style: italic;
    line-height: 1.5;
    font-weight: 300;
  }
  .author {
    margin: 0.75rem 0 0;
    color: var(--color-primary, #d66879);
    font-weight: 600;
    font-size: 0.85rem;
  }
</style>
