---
import Layout from "../layouts/Layout.astro";
import { certificates } from "../data/certificates";
import Avatar from "../components/avatar.astro";
import LayoutGrid from "../layouts/layout-grid.astro";
import CertificatesCard from "../components/certificates-card.astro";
---

<Layout title="Certificados | Claudio Quiroz">
  <LayoutGrid title="Certificados">
    <Avatar slot="avatar" variant="header" />
    <main class="main">
      {
        certificates.map((certificate) => (
          <CertificatesCard certificate={certificate} />
        ))
      }
    </main>
  </LayoutGrid>
</Layout>

<style>
  .main {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    grid-gap: 3rem 1rem;
  }
</style>
